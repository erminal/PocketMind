# =====================================================
# PocketMind 环境变量模板（M1 · 全 API 模式）
# -----------------------------------------------------
# 用法：复制本文件为 .env，填入自己的 API Key 即可；.env 已被 .gitignore 忽略，
#       千万不要把真实 Key 写进本文件或提交到 git。
#
# 数据流向说明（请先读）：
#   M1 不下载本地模型权重，主对话/记忆抽取与向量嵌入都走云 API。
#   记忆原文（含对话内容与抽取出的事实）会发送给下面配置的服务商；
#   请使用带 no-train / 不用于训练 条款的 API 账号，并只在自己信任的网络与设备上运行。
# =====================================================

# ---------- 主对话 + 记忆抽取（DeepSeek，OpenAI 兼容） ----------
POCKETMIND_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
POCKETMIND_MAIN_MODEL=deepseek-flash
# 思考模式：disabled = 关闭（T0/T1 默认，延迟低、语气稳）；enabled = 开启（深思考档）
POCKETMIND_THINKING=disabled

# ---------- 向量嵌入（Qwen / 阿里云百炼 DashScope，OpenAI 兼容） ----------
# 可选值：qwen（默认）｜siliconflow（备选，见文件末尾注释）
POCKETMIND_EMBEDDING_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v4
# 向量维度：留空 = 启动时调用服务商探测并写入本地配置（不同模型/参数维度不同，不要手填猜值）
POCKETMIND_EMBEDDING_DIM=

# ---------- 运行参数 ----------
# 本地数据目录（SQLite、日志、导出文件都放这里；默认已被 .gitignore 忽略）
POCKETMIND_DATA_DIR=./data
# 日志级别：DEBUG / INFO / WARNING / ERROR
POCKETMIND_LOG_LEVEL=INFO

# ---------- 备选：SiliconFlow 嵌入（把上面 POCKETMIND_EMBEDDING_PROVIDER 改成 siliconflow 并取消注释） ----------
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
